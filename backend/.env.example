# Copy to .env (or just paste keys in the app's Settings page)
# Several Gemini keys can be comma-separated; NAS falls back to the next one on quota errors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional, only for pyannote diarization
HF_TOKEN=
# tiny | base | small | medium  (small recommended for Indian languages on 8 GB RAM)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# auto | speechbrain | pyannote
DIARIZATION_BACKEND=auto
NOISE_REDUCTION=true
